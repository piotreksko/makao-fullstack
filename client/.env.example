# Game history from the AWS stack (infra/). Copy to .env.local and fill in
# from the stack outputs: `aws cloudformation describe-stacks --stack-name MakaoStack`.
# These are public identifiers, not secrets. Leave unset to hide the panel.
VITE_HISTORY_API_URL=https://xxxxxxxxxx.execute-api.eu-north-1.amazonaws.com
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=eu-north-1
